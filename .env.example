# Notion API Key (https://www.notion.so/my-integrations 에서 발급받은 Internal Integration Token)
NOTION_API_KEY=your_notion_api_key_here

# Notion 내의 삭제 기록 및 편집 백업 아카이브로 사용할 페이지의 ID (32자리 문자열)
NOTION_TRASH_PAGE_ID=your_trash_page_id_here

# 로컬 Express 서버 포트 및 Vite 프런트엔드 API 주소 설정
PORT=3001
VITE_API_BASE_URL=http://localhost:3001
